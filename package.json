{
  "name": "sotarium-agent",
  "private": true,
  "version": "1.0.5",
  "description": "Sotarium personal agent workspace for Windows",
  "author": "Sotarium",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "desktop:build": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest",
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "build": {
    "appId": "com.sotarium.app",
    "productName": "Sotarium",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/sotarium-icon.ico"
    },
    "portable": {
      "artifactName": "Sotarium.exe",
      "splashImage": null,
      "useZip": false
    },
    "compression": "maximum"
  }
}
